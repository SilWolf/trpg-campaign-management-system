{
	"name": "trpg-campaign-management-system",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build && node scripts/validate-static-image-catalog.mjs --dist",
		"lint": "eslint . && npm run lint:theme-colors",
		"lint:theme-colors": "node scripts/audit-theme-colors.mjs --check",
		"test:e2e": "playwright test",
		"validate:blacksmith-source": "node scripts/validate-blacksmith-source.mjs",
		"validate:static-images": "node scripts/validate-static-image-catalog.mjs",
		"supabase:login": "npx --yes supabase@2.122.0 login",
		"supabase:migrations:list": "npx --yes supabase@2.122.0 migration list --project-ref qbnghekzezuedzhkeotr",
		"supabase:db:dry-run": "npx --yes supabase@2.122.0 db push --dry-run --project-ref qbnghekzezuedzhkeotr",
		"supabase:db:push": "npx --yes supabase@2.122.0 db push --project-ref qbnghekzezuedzhkeotr",
		"supabase:functions:list": "npx --yes supabase@2.122.0 functions list --project-ref qbnghekzezuedzhkeotr",
		"supabase:functions:deploy": "npx --yes supabase@2.122.0 functions deploy --project-ref qbnghekzezuedzhkeotr",
		"split:item-icons": "node .scripts/items-icon-splitter/index.js",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.118.0",
		"@tanstack/react-router": "^1.170.45",
		"lucide-react": "^1.60.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "^10.1.0",
		"sharp": "^0.35.5",
		"vaul": "^1.1.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/router-plugin": "^1.168.47",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"eslint": "^10.13.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.4"
	}
}
